# MySQL connection string, e.g. mysql://root:password@localhost:3306/tapiz_boards
DATABASE_URL=

# Required if your provider enforces TLS with a CA cert (e.g. Aiven).
# Base64 of ca.pem — leave empty for local MySQL without TLS.
# Generate with: base64 -w0 ca.pem
DATABASE_SSL_CA_BASE64=

# Auth.js session secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# Required — keeps Auth.js working correctly behind a reverse proxy/PaaS (e.g. Vercel).
AUTH_TRUST_HOST=true

# Public URL of your deployment, e.g. https://boards.example.com
# Not needed for local development.
AUTH_URL=

# Optional — MySQL pool size, defaults to 1 (safe for small serverless plans).
# DATABASE_POOL_LIMIT=1

# Optional — public site URL used for metadata/robots/sitemap. Defaults to
# http://localhost:3004 if unset; set this in production.
NEXT_PUBLIC_SITE_URL=

# Optional — protects /api/cron/cleanup (activity-history retention).
# Only needed if you wire up the scheduled cleanup (see .github/workflows/cleanup-cron.yml),
# which stays skipped until the CLEANUP_URL repository variable is set.
CRON_SECRET=
