{
  "name": "tapiz-boards-oss",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted, open-source Kanban/sprints tool for small teams.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/owlCoder/tapiz-boards-oss"
  },
  "homepage": "https://github.com/owlCoder/tapiz-boards-oss",
  "scripts": {
    "dev": "next dev -p 3004",
    "build": "next build",
    "start": "next start -p 3004",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:backfill-import-snapshots": "tsx --env-file=.env scripts/backfill-import-author-snapshots.ts",
    "db:upgrade": "node scripts/db-upgrade.mjs",
    "create-admin": "tsx --env-file=.env scripts/create-admin.ts",
    "smoke": "tsx --env-file=.env scripts/smoke.ts",
    "test:board": "tsx --env-file=.env scripts/board-integrity.ts",
    "test:project-import": "tsx --test tests/project-import-validation.test.ts",
    "test:design": "node scripts/check-oss-design.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tapizlabs/app-kit": "^0.1.2",
    "@tapizlabs/ui": "^2.3.16",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "mysql2": "^3.22.6",
    "next": "^16.2.10",
    "next-auth": "^5.0.0-beta.31",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.1"
    },
    "drizzle-kit": {
      "esbuild": "^0.28.1"
    },
    "next": {
      "postcss": "^8.5.15"
    }
  }
}
